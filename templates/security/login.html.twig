{# Built on EasyAdmin's own login page so it shares the light/dark scheme, fonts and form styles without any CDN.
   Port of Okean's admin_login.html.twig. #}
{% extends '@EasyAdmin/page/login.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ admin_theme_css() }}">
{% endblock %}

{% block wrapper_wrapper %}
    <script src="{{ asset('page-color-scheme.js', constant('EasyCorp\\Bundle\\EasyAdminBundle\\Asset\\AssetPackage::PACKAGE_NAME')) }}"></script>
    {{ parent() }}
{% endblock %}

{% block header_logo %}
    <div class="logo pg-login-logo"><i class="fa fa-right-left"></i> payment-gateway</div>
    <div class="pg-login-subtitle">Admin panel</div>
{% endblock %}
