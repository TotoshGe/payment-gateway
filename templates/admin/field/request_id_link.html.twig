{# Request's own gateway id on a request list: short, links to its card, full id copyable. #}
{% set id = field.value is null ? '' : field.value ~ '' %}
{% if id is empty %}
    <span class="pg-muted">—</span>
{% else %}
    <span class="pg-copy">
        <a class="pg-copy__text" href="{{ ea_url().setController(ea.context.crud.controllerFqcn).setAction('detail').setEntityId(id) }}" title="{{ id }}">{{ id|slice(0, 8) }}…</a>
        <button type="button" class="pg-copy__btn" data-pg-copy="{{ id }}" title="Скопировать" aria-label="Скопировать"><i class="fa fa-regular fa-copy" aria-hidden="true"></i></button>
    </span>
{% endif %}
