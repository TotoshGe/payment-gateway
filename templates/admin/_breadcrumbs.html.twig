{# Home > menu group > list > current page. Only for CRUD pages; the dashboard is the root and needs none. #}
{% set ea_ctx = ea() %}
{% set crud = ea_ctx.crud %}
{% if crud is not null %}
    {% set group = ea_ctx.mainMenu.items|filter(item => item.hasSubItems and item.isExpanded)|first %}
    {% set action = crud.currentAction %}
    {% set entity = ea_ctx.entity %}
    {% set entity_id = entity is not null ? ('' ~ entity.primaryKeyValue) : '' %}
    {% set entity_ref = entity_id|length > 12 ? '#' ~ entity_id|slice(0, 8) : (entity_id != '' ? '#' ~ entity_id : '') %}
    <nav class="pg-crumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="{{ path(ea_ctx.dashboardRouteName) }}"><i class="fa fa-house" aria-hidden="true"></i><span class="visually-hidden">Dashboard</span></a></li>
            {% if group %}<li class="pg-crumbs__group">{{ group.label|raw }}</li>{% endif %}
            {% if action == 'index' %}
                <li aria-current="page">{{ crud.entityLabelInPlural|trans }}</li>
            {% else %}
                <li><a href="{{ ea_url().setController(crud.controllerFqcn).setAction('index').unset('entityId') }}">{{ crud.entityLabelInPlural|trans }}</a></li>
                {% if action == 'detail' %}
                    <li aria-current="page">{{ crud.entityLabelInSingular|trans }} {{ entity_ref }}</li>
                {% elseif action == 'edit' %}
                    <li aria-current="page">Edit {{ entity_ref }}</li>
                {% elseif action == 'new' %}
                    <li aria-current="page">New</li>
                {% elseif entity_ref != '' %}
                    <li aria-current="page">{{ entity_ref }}</li>
                {% endif %}
            {% endif %}
        </ol>
    </nav>
{% endif %}
