{# Replaces the stock grey skeleton rows + plain "No results found" text with one centred icon+message row, applied
   to every list page. Port of Okean's crud/index.html.twig override (without the columns picker button, which was
   an extra feature, not part of the shell). #}
{% extends '@!EasyAdmin/crud/index.html.twig' %}

{% block table_body_empty %}
    <tr class="pg-empty-row">
        <td colspan="100">
            <div class="pg-empty-state">
                <i class="fa fa-inbox" aria-hidden="true"></i>
                <p class="pg-empty-state__title">Здесь пока пусто</p>
                <p class="pg-empty-state__text">Нет записей, соответствующих текущему виду.</p>
            </div>
        </td>
    </tr>
{% endblock %}

{# A list page's setHelp() text is otherwise only in a hover popover; show it inline (used by the routing page). #}
{% block main %}
    {% if ea.crud.helpMessage is not empty %}
        <div class="pg-note">{{ ea.crud.helpMessage|raw }}</div>
    {% endif %}
    {{ parent() }}
{% endblock %}
