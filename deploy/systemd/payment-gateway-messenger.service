[Unit]
Description=Payment gateway messenger worker (callbacks to Okean, transport "async")
After=network-online.target mariadb.service
Wants=network-online.target
# Never give up restarting (a crash loop while the DB is down must not leave callbacks undelivered).
StartLimitIntervalSec=0

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/payment-gateway
# The worker exits on its own after an hour / 128M so a fresh process picks up deployed code and never leaks
# memory; Restart=always brings it straight back. Retries/backoff of a failed delivery are Messenger's own
# retry_strategy (config/packages/messenger.yaml), exhausted messages land in the "failed" transport.
ExecStart=/usr/bin/php /var/www/html/payment-gateway/bin/console messenger:consume async --time-limit=3600 --memory-limit=128M --env=prod --no-debug
# Let the in-flight callback finish before stopping (Messenger handles SIGTERM gracefully).
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=5
Environment=XDEBUG_MODE=off

StandardOutput=journal
StandardError=journal
SyslogIdentifier=payment-gateway-messenger

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
